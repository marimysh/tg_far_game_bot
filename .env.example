# Telegram
BOT_TOKEN=123456:AAA...

# Разрешённые чаты/топики (формат chatId_threadId, через запятую; * — для отладки)
ALLOWED_TOPICS=-100xxxxxxxxx_yyy,-100xxxxxxxxx_zzzz

# Google OAuth2 (приложение с доступом к Sheets; долгосрочно лучше service account)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REFRESH_TOKEN=1//0xxx

# Таблица очереди (id из URL таблицы)
SPREADSHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHEET_NAME=Полный список

# Дайджест очереди (пустой DIGEST_CHAT_ID отключает)
DIGEST_CHAT_ID=-100xxxxxxxxx
DIGEST_THREAD_ID=zzzz
DIGEST_POLL_SEC=60

# Состояние диалогов (JSON-файл)
STATE_FILE=/opt/far-bot/state.json

# Опционально: сюда приходят алерты об ошибках бота
# ADMIN_CHAT_ID=-100xxxxxxxxx

# Опционально: сюда приходят заявки на подключение новых чатов и ссылки на таблицы
# (можно с топиком: "chatId/threadId"; пустой = тот же чат, что ADMIN_CHAT_ID)
# REQUESTS_CHAT_ID=-100xxxxxxxxx/yyy
